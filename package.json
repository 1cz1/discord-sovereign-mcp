{
  "name": "discord-sovereign-mcp",
  "version": "0.2.0",
  "description": "Full-lifecycle Discord MCP server: create, administer, and scaffold entire Discord servers from any LLM: gated by a Sovereignty Guard that only operates when the client holds the #1 role.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "discord-sovereign-mcp": "dist/index.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit -p tsconfig.json && vitest run",
    "oauth": "tsx scripts/oauth-bootstrap.ts",
    "install:mcp": "tsx src/bootstrap/installCli.ts",
    "eval": "node scripts/eval-runner.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "discord",
    "discord-bot",
    "discord-api",
    "llm",
    "ai",
    "server-management",
    "sovereignty"
  ],
  "dependencies": {
    "@discordjs/rest": "^2.4.3",
    "@modelcontextprotocol/sdk": "^1.13.0",
    "discord-api-types": "^0.37.119",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
