# Copy to .env and fill in. Never commit .env.
# ── token ──────────────────────────────────────────────────────────────
# Bot: create an application -> Bot -> copy token. Enable SERVER MEMBERS INTENT
# and MESSAGE CONTENT INTENT. OAuth2: run `npm run oauth` and this file is
# populated automatically (DISCORD_TOKEN_TYPE=oauth2).
DISCORD_TOKEN=
DISCORD_TOKEN_TYPE=auto        # auto | bot | oauth2 | user

# ── blast radius ───────────────────────────────────────────────────────
# Comma-separated guild IDs the agent is allowed to touch. Empty = all.
# STRONGLY RECOMMENDED: pin to your test server while evaluating.
DISCORD_ALLOWED_GUILDS=

# ── transport ──────────────────────────────────────────────────────────
TRANSPORT=stdio                # stdio | http
HTTP_HOST=127.0.0.1            # keep loopback unless you know what you're doing
HTTP_PORT=3000

# ── OAuth2 (user-token mode) ───────────────────────────────────────────
# Discord developer portal -> OAuth2 -> General: add redirect
#   http://localhost:8788/callback
DISCORD_OAUTH2_CLIENT_ID=
DISCORD_OAUTH2_CLIENT_SECRET=
DISCORD_OAUTH2_REDIRECT_URI=http://localhost:8788/callback
DISCORD_OAUTH2_PORT=8788

# ── misc ───────────────────────────────────────────────────────────────
AUDIT_REASON=via discord-sovereign-mcp
LOG_LEVEL=info                 # info | debug | warn | error