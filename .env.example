# ── Discord Sovereign MCP configuration ────────────────────────────────
# Copy to .env and fill in. See README.md for full instructions.

# Required: your bot token (https://discord.com/developers/applications)
# OR a user token obtained via the OAuth2 bootstrap (scripts/oauth-bootstrap.ts)
DISCORD_TOKEN=

# auto | bot | oauth2 | user
#   auto    → detect by calling GET /users/@me (recommended)
#   bot     → force Bot <token> authorization
#   oauth2  → force Bearer <token> authorization (user/OAuth2 token)
DISCORD_TOKEN_TYPE=auto

# Comma-separated guild IDs this server is allowed to act on. Empty = all.
# Strongly recommended for shared/bot tokens.
DISCORD_ALLOWED_GUILDS=

# stdio | http   (stdio for Claude Desktop / Claude Code; http for remote)
TRANSPORT=stdio
HTTP_HOST=127.0.0.1
HTTP_PORT=3000

# ── OAuth2 bootstrap (required only to CREATE servers from scratch) ─────
# Create an application, add http://localhost:8788/callback as redirect URI
DISCORD_OAUTH2_CLIENT_ID=
DISCORD_OAUTH2_CLIENT_SECRET=
DISCORD_OAUTH2_REDIRECT_URI=http://localhost:8788/callback
DISCORD_OAUTH2_PORT=8788

# Audit-log reason stamped on every mutating request
AUDIT_REASON=via discord-sovereign-mcp

# info | debug | warn | error
LOG_LEVEL=info